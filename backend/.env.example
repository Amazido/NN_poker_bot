# === Общее ===
DEBUG=true
HOST=0.0.0.0
PORT=8000
ENV=local

# === Telegram ===
# Токен бота для проверки подписи Telegram WebApp initData
TELEGRAM_BOT_TOKEN=
# Начальный баланс новых Telegram-пользователей
TELEGRAM_INITIAL_BALANCE=1000

# === JWT ===
# Если не задан — в DEBUG используется dev-secret-key
JWT_SECRET=dev-secret-key

# === PostgreSQL ===
# Формат: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/odessa_dev

# === Redis ===
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=dev

# === Centrifugo ===
CENTRIFUGO_API_URL=http://localhost:8001/api
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_TOKEN_SECRET=dev-centrifugo-secret
CENTRIFUGO_CHANNEL_PREFIX=dev

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
